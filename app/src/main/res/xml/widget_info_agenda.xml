<?xml version="1.0" encoding="utf-8"?>
<!-- Event driven: updatePeriodMillis is 0 and the app pushes updates after data changes and at midnight. -->
<!-- targetCell*, maxResize*, previewLayout and widgetFeatures are read by Android 12+ (9+ for widgetFeatures); older
     launchers use minWidth/minHeight and always run the configuration screen. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_agenda_picker_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="600dp"
    android:maxResizeHeight="600dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:previewLayout="@layout/widget_preview_agenda"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
