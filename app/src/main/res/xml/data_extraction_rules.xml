<?xml version="1.0" encoding="utf-8"?>
<!-- Taskfern keeps data on the device. Cloud backup and device-to-device transfer are off; use the app's own JSON
     backup (Settings > Backup & restore), which the user controls. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
