<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="backup_title">Backup &amp; restore</string>
    <string name="backup_intro">Taskfern keeps everything on this phone. A backup is one file that you save wherever you like and can restore on this or another phone.</string>
    <string name="backup_section_export">Back up</string>
    <string name="backup_section_restore">Restore</string>

    <string name="backup_export">Export backup</string>
    <string name="backup_export_summary">Tasks, lists, shopping, routines, templates, focus history and your settings in a single JSON file.</string>
    <string name="backup_export_button">Export</string>
    <string name="backup_calendar">Export to calendar (.ics)</string>
    <string name="backup_calendar_summary">Open tasks with a due date as calendar events, for importing into a calendar app. Repeating tasks repeat there too when the rule has an exact match.</string>
    <string name="backup_calendar_button">Export calendar</string>
    <string name="backup_import">Restore from a backup</string>
    <string name="backup_import_summary">Choose a Taskfern backup file. You’ll see what it contains before anything changes.</string>
    <string name="backup_import_button">Choose file</string>

    <string name="backup_working_export">Saving backup…</string>
    <string name="backup_working_calendar">Saving calendar file…</string>
    <string name="backup_working_read">Checking the backup…</string>
    <string name="backup_working_import">Restoring…</string>

    <string name="backup_preview_title">Ready to restore</string>
    <string name="backup_preview_from">Backup from %1$s · Taskfern %2$s</string>
    <string name="backup_preview_empty">This backup is empty.</string>
    <string name="backup_restore_settings">Also restore settings</string>
    <string name="backup_merge">Merge</string>
    <string name="backup_replace">Replace</string>
    <string name="backup_merge_explain">Merge keeps everything you have and adds what’s new. Lists, shopping lists and routines with the same name are combined; tasks with the same title and creation time are skipped.</string>
    <string name="backup_replace_explain">Replace deletes the current data on this phone and restores the backup exactly.</string>
    <string name="backup_replace_title">Replace all data?</string>
    <string name="backup_replace_message">This deletes everything currently in Taskfern on this phone (%1$s) and replaces it with the backup. This can’t be undone.</string>
    <string name="backup_replace_nothing">There’s no data on this phone yet, so nothing will be lost.</string>
    <string name="backup_replace_hint">Home-screen widgets are kept. If you’re unsure, export a backup of the current data first.</string>
    <string name="backup_replace_confirm">Delete and replace</string>

    <string name="backup_exported_title">Backup saved</string>
    <string name="backup_exported">Saved %1$s, plus your settings.</string>
    <string name="backup_exported_empty">Saved your settings. There are no tasks or lists yet.</string>
    <string name="backup_merged_title">Backup merged</string>
    <string name="backup_merged_added">Added %1$s.</string>
    <string name="backup_merged_nothing">Everything in the backup was already here; nothing was added.</string>
    <string name="backup_merged_skipped">Skipped as already present: %1$s.</string>
    <string name="backup_replaced_title">Backup restored</string>
    <string name="backup_replaced">Restored %1$s.</string>
    <string name="backup_replaced_empty">The backup was empty, so Taskfern is now empty too.</string>
