    <string name="backup_calendar_empty">Calendar file saved. No open tasks have a due date yet.</string>

    <string name="backup_error_not_json_title">This isn’t a backup file</string>
    <string name="backup_error_not_json">The file is empty or isn’t JSON. Choose the .json file that Taskfern exported. Nothing was changed.</string>
    <string name="backup_error_format_title">Not a Taskfern backup</string>
    <string name="backup_error_format">The file is JSON, but it wasn’t made by Taskfern’s export. Nothing was changed.</string>
    <string name="backup_error_newer_title">Made by a newer Taskfern</string>
    <string name="backup_error_newer">This backup uses format version %1$d, and this app reads up to version %2$d. Update Taskfern and try again. Nothing was changed.</string>
    <string name="backup_error_invalid_title">The backup is damaged</string>
    <string name="backup_error_invalid">Some data is missing, has unexpected values or points to things that aren’t in the file. Nothing was changed.</string>
    <string name="backup_error_unreadable_title">Couldn’t read the file</string>
    <string name="backup_error_unreadable">Android couldn’t open it. If the file is in a cloud folder, make sure it has finished downloading. Nothing was changed.</string>
    <string name="backup_error_write_title">Couldn’t save the file</string>
    <string name="backup_error_write">Try another folder or check that there’s free space.</string>
    <string name="backup_error_import_title">Restore failed</string>
    <string name="backup_error_import">Something went wrong while restoring, so the change was rolled back. Your data is as it was.</string>

